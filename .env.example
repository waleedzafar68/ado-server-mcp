# ado-server-mcp server settings. Copy to .env and adjust. Never put a PAT in this file:
# in HTTP mode every caller sends their own PAT (Authorization: Bearer <PAT>), and startup fails if ADO_PAT is set.

# Azure DevOps Server base URL, without the collection.
ADO_DEFAULT_SERVER_URL=https://devops.example.com/tfs
# Hosts callers may target with X-ADO-Server-URL (comma-separated).
ADO_ALLOWED_HOSTS=devops.example.com
# Internal host names in git remotes mapped to an allowed host, e.g. legacy-devops:8080=devops.example.com
ADO_HOST_ALIASES=

ADO_MCP_TRANSPORT=http
ADO_MCP_HOST=0.0.0.0
ADO_MCP_PORT=8080
ADO_MCP_PATH=/mcp

# Optional shared gateway token (>= 32 chars). Callers send it as X-ADO-MCP-Token: <token>.
# Without it the server warns at startup when it listens beyond localhost. Generate one with: openssl rand -hex 32
ADO_MCP_HTTP_TOKEN=
# Browser origins allowed to call /mcp (comma-separated). CLI and IDE clients send no Origin and are unaffected.
ADO_MCP_ALLOWED_ORIGINS=
# Express "trust proxy" so rate limiting sees real client addresses behind a proxy: a hop count (1 for one proxy),
# the proxy addresses or subnets, or "loopback". "true" and /0 subnets (0.0.0.0/0, ::/0, also in a list) are refused, because
# callers could then fake their address. A hop count must equal the real number of proxies; more has the same effect.
# Set "false" when clients connect directly; left empty on a non-loopback host, startup prints a warning.
ADO_MCP_TRUST_PROXY=

# all, or a comma-separated subset of: projects,workitems,queries,boards,repositories,pullrequests,builds,releases,wiki,tfvc
ADO_MCP_TOOLSETS=all
ADO_MCP_READ_ONLY=false
ADO_MCP_STATELESS=false
ADO_MCP_SESSION_IDLE_MS=1800000
ADO_MCP_MAX_SESSIONS=200
ADO_MCP_MAX_SESSIONS_PER_USER=10
# Failed authentications (401) per caller (address + credentials) in 5 minutes before 429; an address alone gets 10x.
ADO_MCP_AUTH_FAILURE_LIMIT=20
# How long your MCP clients wait for a tool call (ms, >= 30000). Destructive calls stop prompting and refuse
# to start the first write within the last 10 s of it. Raise it to match clients configured with a longer timeout.
ADO_MCP_CLIENT_TIMEOUT_MS=60000
# JSON audit lines on stderr: one per tool call, session open/close and refused admission.
# Tool calls log argument names plus id and enum values (PR, build, release ids; action, vote, status). Free text is never logged.
ADO_MCP_AUDIT_LOG=true

ADO_REQUEST_TIMEOUT_MS=30000
# Largest Azure DevOps response body read into memory (bytes).
ADO_MAX_RESPONSE_BYTES=10485760
# Pin a REST version for every collection instead of negotiating (normally leave empty).
ADO_FORCE_API_VERSION=
